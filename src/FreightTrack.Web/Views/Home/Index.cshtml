@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["TourNav"] = true;        // this page's tour also explains the navbar
    ViewData["TourAutostart"] = true;  // and starts automatically on someone's first visit
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Operations dashboard</h1>
    <span class="text-muted">@Model.Today.ToString("dddd, d MMMM yyyy")</span>
</div>

<div class="row g-3 mb-4" data-tour-step="3" data-tour-title="Today at a glance"
     data-tour="Live totals across all shipments. In progress means anything not yet delivered.">
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Total shipments</div>
            <div class="stat-value">@Model.TotalShipments</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">In progress</div>
            <div class="stat-value">@Model.InProgressCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <a class="card stat-card h-100 text-decoration-none border-danger" data-tour-step="4" data-tour-title="Late shipments"
           data-tour="A shipment is late when it isn't delivered and today is past its expected delivery date. Click to see them all." asp-controller="Shipments" asp-action="Index" asp-route-lateOnly="true">
            <div class="card-body">
                <div class="stat-label">Late</div>
                <div class="stat-value text-danger">@Model.LateCount</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Delivered</div>
            <div class="stat-value text-success">@Model.StatusCounts.First(c => c.Status == ShipmentStatus.Delivered).Count</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100" data-tour-step="5" data-tour-title="Where everything is"
             data-tour="How many shipments are at each stage. Click a status to open the shipment list filtered to it.">
            <div class="card-header fw-semibold">Shipments by status</div>
            <div class="list-group list-group-flush">
                @foreach (var (status, count) in Model.StatusCounts)
                {
                    <a class="list-group-item status-tile d-flex justify-content-between align-items-center"
                       asp-controller="Shipments" asp-action="Index" asp-route-status="@status">
                        <partial name="_StatusBadge" model="status" />
                        <span class="fw-semibold">@count</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100" data-tour-step="6" data-tour-title="Start your day here"
             data-tour="The ten most overdue shipments, worst first. Click a tracking number to see its journey and record an update.">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">10 most overdue shipments</span>
                <a asp-controller="Shipments" asp-action="Index" asp-route-lateOnly="true" class="small">View all late</a>
            </div>
            @if (Model.MostOverdue.Count == 0)
            {
                <div class="card-body text-muted">Nothing is late. 🎉</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tracking #</th>
                                <th>Customer</th>
                                <th>Destination</th>
                                <th>Status</th>
                                <th class="text-end">Days late</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.MostOverdue)
                            {
                                <tr>
                                    <td><a class="tracking-number" asp-controller="Shipments" asp-action="Details" asp-route-id="@s.Id">@s.TrackingNumber</a></td>
                                    <td>@s.Customer.CompanyName</td>
                                    <td>@s.Destination</td>
                                    <td><partial name="_StatusBadge" model="s.CurrentStatus" /></td>
                                    <td class="text-end fw-semibold text-danger">@s.DaysOverdue(Model.Today)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
