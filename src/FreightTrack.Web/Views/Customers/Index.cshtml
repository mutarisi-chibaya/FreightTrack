@model CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customers</h1>
    <a class="btn btn-primary" asp-action="Create" data-tour-step="3" data-tour-title="Add a customer"
       data-tour="Add the customer once, then book as many shipments for them as you need.">+ New customer</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3" data-tour-step="1" data-tour-title="Find a customer"
      data-tour="Search by part of the company name or the contact person's name.">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="search" value="@Model.Search" class="form-control"
               placeholder="Search by company or contact name" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-action="Index" class="btn btn-link">Clear</a>
        }
    </div>
</form>

<div class="card" data-tour-step="2" data-tour-title="Customer list"
     data-tour="Click a company to see all its shipments and a summary by status.">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Company</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th class="text-end">Shipments</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold">@c.CompanyName</a></td>
                        <td>@c.ContactName</td>
                        <td><a href="mailto:@c.Email">@c.Email</a></td>
                        <td>@c.City, @c.Country</td>
                        <td class="text-end">@c.ShipmentCount</td>
                        <td class="text-end"><a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a></td>
                    </tr>
                }
                @if (Model.Customers.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted text-center py-4">No customers match "@Model.Search".</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
