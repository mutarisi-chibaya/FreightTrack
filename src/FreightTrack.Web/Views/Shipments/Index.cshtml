@model ShipmentListViewModel
@{
    ViewData["Title"] = "Shipments";
    var f = Model.Filter;
    var r = Model.Results;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Shipments</h1>
    <a class="btn btn-primary" asp-action="Create" data-tour-step="1" data-tour-title="Book a shipment"
       data-tour="Start here when a customer books. The tracking number is created for you.">+ New shipment</a>
</div>

@* GET form: the filters end up in the URL, so a filtered list can be bookmarked or shared. *@
<form method="get" asp-action="Index" class="card card-body mb-3" data-tour-step="2" data-tour-title="Narrow it down"
      data-tour="Combine filters, e.g. Sea + In transit + Late only, then press Filter. The filters stay in the address bar, so you can bookmark or share the result.">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-lg-3">
            <label class="form-label small mb-1" for="status">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="">Any status</option>
                @foreach (var s in Enum.GetValues<ShipmentStatus>())
                {
                    <option value="@s" selected="@(f.Status == s)">@s.GetDisplayName()</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label class="form-label small mb-1" for="mode">Mode</label>
            <select id="mode" name="mode" class="form-select">
                <option value="">Any mode</option>
                @foreach (var m in Enum.GetValues<ShipmentMode>())
                {
                    <option value="@m" selected="@(f.Mode == m)">@m</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-lg-3">
            <label class="form-label small mb-1" for="customerId">Customer</label>
            <select id="customerId" name="customerId" class="form-select">
                <option value="">Any customer</option>
                @foreach (var c in Model.Customers)
                {
                    <option value="@c.Value" selected="@(f.CustomerId?.ToString() == c.Value)">@c.Text</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="lateOnly" name="lateOnly" value="true" checked="@f.LateOnly" />
                <label class="form-check-label" for="lateOnly">Late only</label>
            </div>
        </div>
        <div class="col-lg-2 text-lg-end">
            <button type="submit" class="btn btn-outline-primary">Filter</button>
            <a asp-action="Index" class="btn btn-link px-2">Clear</a>
        </div>
    </div>
</form>

<div class="card" data-tour-step="3" data-tour-title="The shipment list"
     data-tour="Newest bookings first. Late shipments show how many days overdue they are. Use Update on a row to record where the goods are now.">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tracking #</th>
                    <th>Customer</th>
                    <th>Route</th>
                    <th>Mode</th>
                    <th>Status</th>
                    <th>Expected</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in r.Items)
                {
                    var late = s.IsLate(Model.Today);
                    <tr>
                        <td><a class="tracking-number" asp-action="Details" asp-route-id="@s.Id">@s.TrackingNumber</a></td>
                        <td>@s.Customer.CompanyName</td>
                        <td class="small">@s.Origin &rarr; @s.Destination</td>
                        <td>@s.Mode</td>
                        <td><partial name="_StatusBadge" model="s.CurrentStatus" /></td>
                        <td class="text-nowrap @(late ? "text-danger fw-semibold" : "")">
                            @s.ExpectedDeliveryDate.ToString("yyyy-MM-dd")
                            @if (late) { <span class="badge text-bg-danger ms-1">@s.DaysOverdue(Model.Today)d late</span> }
                        </td>
                        <td class="text-end">
                            @if (s.CurrentStatus != ShipmentStatus.Delivered)
                            {
                                @* Jumps straight to the update panel on the shipment page. *@
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@s.Id" asp-fragment="update">Update</a>
                            }
                        </td>
                    </tr>
                }
                @if (r.TotalCount == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No shipments match these filters.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
        <span class="text-muted small">
            @if (r.TotalCount > 0)
            {
                @($"Showing {(r.Page - 1) * r.PageSize + 1}–{(r.Page - 1) * r.PageSize + r.Items.Count} of {r.TotalCount}")
            }
        </span>
        <nav aria-label="Shipment pages">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(r.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteFor(r.Page - 1)">Previous</a>
                </li>
                @for (var p = 1; p <= r.TotalPages; p++)
                {
                    <li class="page-item @(p == r.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteFor(p)">@p</a>
                    </li>
                }
                <li class="page-item @(r.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="Model.RouteFor(r.Page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
