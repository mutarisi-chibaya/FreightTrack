@model ShipmentFormViewModel
@{
    ViewData["Title"] = "Edit shipment";
}

<h1 class="h3 mb-1">Edit shipment</h1>
<p class="text-muted">To change the status, add a status update on the shipment's details page.</p>

<div class="card"><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <partial name="_ShipmentForm" model="Model" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
